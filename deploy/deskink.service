[Unit]
Description=deskink e-ink desk dashboard
Wants=network-online.target
After=network-online.target

[Service]
User=deskink
Group=deskink
SupplementaryGroups=spi gpio
EnvironmentFile=-/etc/deskink/deskink.env
Environment=PYTHONPATH=@APP@/src
Environment=DESKINK_DRIVER_DIR=@APP@/vendor
Environment=PYTHONUNBUFFERED=1
StateDirectory=deskink
WorkingDirectory=/var/lib/deskink
ExecStart=/usr/bin/python3 -m deskink -c /etc/deskink/config.toml run
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
